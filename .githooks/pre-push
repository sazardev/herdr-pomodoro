#!/usr/bin/env bash
# Heavier gate before code leaves the machine: full lint pass + tests.
# Uses debug builds only (never --release: opt-level "z" + LTO + a single
# codegen unit make that profile far too slow for a hook).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo clippy"
if ! cargo clippy --all-targets --all-features --quiet -- -D warnings; then
    echo "pre-push: clippy found issues -- fix them before pushing" >&2
    exit 1
fi

echo "pre-push: cargo test"
if ! cargo test --quiet; then
    echo "pre-push: tests failed -- fix them before pushing" >&2
    exit 1
fi
